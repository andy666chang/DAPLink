#
# Common build settings for the DAPLink Zephyr port (app = interface,
# bootloader = bootloader). Include before find_package(Zephyr).
#
#   DAPLINK_IMAGE  BL or IF

set(DAPLINK_COMMON_DIR ${CMAKE_CURRENT_LIST_DIR})
set(DAPLINK_DIR ${DAPLINK_COMMON_DIR}/daplink)

# DAPLink records/hic_hal/stm32f103xb.yaml, records/tools/version.yaml
set(DAPLINK_HIC_ID  0x97969908)   # DAPLINK_HIC_ID_STM32F103XB
set(DAPLINK_VERSION 257)
set(DAPLINK_BUILD_KEY_IF 0x9B939E8F)
set(DAPLINK_BUILD_KEY_BL 0x9B939D93)

if(DAPLINK_IMAGE STREQUAL "BL")
  set(DAPLINK_BUILD_KEY ${DAPLINK_BUILD_KEY_BL})
  set(DAPLINK_REGION_SIZE 0xBC00)     # DAPLINK_ROM_BL_SIZE
  set(DAPLINK_OUTPUT_NAME stm32f103xb_bl)
elseif(DAPLINK_IMAGE STREQUAL "IF")
  set(DAPLINK_BUILD_KEY ${DAPLINK_BUILD_KEY_IF})
  set(DAPLINK_REGION_SIZE 0x13C00)    # DAPLINK_ROM_IF_SIZE
  set(DAPLINK_OUTPUT_NAME stm32f103xb_if)
else()
  message(FATAL_ERROR "DAPLINK_IMAGE must be BL or IF")
endif()

# Python for post_build.py (needs intelhex, pyelftools from
# zephyr-rtos/scripts/requirements.txt), WEST_PYTHON is set by west build
if(DEFINED WEST_PYTHON)
  set(DAPLINK_PYTHON ${WEST_PYTHON})
else()
  find_program(DAPLINK_PYTHON NAMES python3 python REQUIRED)
endif()

# <name>_crc.hex/.bin with DAPLink header + CRC, like progen_compile.
# Registered before find_package(Zephyr), which processes zephyr/CMakeLists.txt
set(DAPLINK_CRC_OUTPUT ${CMAKE_BINARY_DIR}/${DAPLINK_OUTPUT_NAME}_crc)
set_property(GLOBAL APPEND PROPERTY extra_post_build_commands
  COMMAND ${DAPLINK_PYTHON} ${DAPLINK_COMMON_DIR}/scripts/post_build.py
    --hex ${CMAKE_BINARY_DIR}/zephyr/zephyr.hex
    --elf ${CMAKE_BINARY_DIR}/zephyr/zephyr.elf
    --output ${DAPLINK_CRC_OUTPUT}
    --build-key ${DAPLINK_BUILD_KEY}
    --hic-id ${DAPLINK_HIC_ID}
    --version ${DAPLINK_VERSION}
    --size ${DAPLINK_REGION_SIZE}
)
set_property(GLOBAL APPEND PROPERTY extra_post_build_byproducts
  ${DAPLINK_CRC_OUTPUT}.hex ${DAPLINK_CRC_OUTPUT}.bin ${DAPLINK_CRC_OUTPUT}.txt)

# Shared board overlay (pins, partitions, shared RAM)
list(APPEND EXTRA_DTC_OVERLAY_FILE ${DAPLINK_COMMON_DIR}/boards/stm32_min_dev_stm32f103xb.overlay)

# Called after find_package(Zephyr)
function(daplink_setup)
  zephyr_compile_definitions(
    INTERFACE_STM32F103XB
    DAPLINK_${DAPLINK_IMAGE}
    DAPLINK_HIC_ID=${DAPLINK_HIC_ID}
    DAPLINK_VERSION=${DAPLINK_VERSION}
    DAPLINK_BUILD_KEY=${DAPLINK_BUILD_KEY}
    DAPLINK_NO_ASSERT_FILENAMES
    # DAPLink error.h defines its own error_t, skip the picolibc
    # <errno.h> "typedef int error_t"
    __error_t_defined=1
  )

  # version_git.h, like DAPLink tools/pre_build_script.py
  set(version_dir ${CMAKE_BINARY_DIR}/daplink)
  execute_process(COMMAND git rev-parse HEAD
    WORKING_DIRECTORY ${DAPLINK_COMMON_DIR}
    OUTPUT_VARIABLE git_sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND git describe --always --dirty
    WORKING_DIRECTORY ${DAPLINK_COMMON_DIR}
    OUTPUT_VARIABLE git_desc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  execute_process(COMMAND git diff --quiet HEAD -- ${DAPLINK_COMMON_DIR}/..
    WORKING_DIRECTORY ${DAPLINK_COMMON_DIR}
    RESULT_VARIABLE git_dirty ERROR_QUIET)
  if(NOT git_sha)
    set(git_sha "0000000000000000000000000000000000000000")
    set(git_desc "unknown")
  endif()
  if(git_dirty)
    set(git_mods 1)
  else()
    set(git_mods 0)
  endif()
  file(WRITE ${version_dir}/version_git.h.tmp
    "/* Generated by common/daplink.cmake */\n"
    "#ifndef VERSION_GIT_H\n"
    "#define VERSION_GIT_H\n"
    "#define GIT_COMMIT_SHA  \"${git_sha}\"\n"
    "#define GIT_LOCAL_MODS  ${git_mods}\n"
    "#define GIT_DESCRIPTION \"${git_desc}\"\n"
    "#endif\n")
  configure_file(${version_dir}/version_git.h.tmp ${version_dir}/version_git.h COPYONLY)
  zephyr_include_directories(${version_dir})

endfunction()
